---
import Base from '~/layouts/Base.astro';
import { url } from '~/lib/url';
import { getPlayerIndex, getTournamentIndex } from '~/lib/data';

const players = getPlayerIndex();
const tournaments = getTournamentIndex();

const groups = [
  { key: 'male', label: 'Men', players: players.filter(p => p.gender === 'male') },
  { key: 'female', label: 'Women', players: players.filter(p => p.gender === 'female') },
].map(g => ({
  ...g,
  totalPodiums: g.players.reduce((s, p) => s + p.podium.first + p.podium.second + p.podium.third, 0),
  totalFirsts: g.players.reduce((s, p) => s + p.podium.first, 0),
  topByWins: [...g.players]
    .sort((a, b) => b.podium.first - a.podium.first || b.podium.top8 - a.podium.top8)
    .slice(0, 10),
}));

const latestTournaments = [...tournaments]
  .filter(t => (t.categories?.length ?? 0) > 0)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 6);

const seasons = new Set(tournaments.map(t => t.season)).size;
---
<Base title="Home" active="home">
  <section class="hero">
    <p class="hero-eyebrow">Maharashtra Carrom · unofficial stats</p>
    <h1 class="hero-title">Every top-8 finish, every rivalry, across {seasons} seasons.</h1>
    <p class="hero-lead">
      Player achievements aggregated from public MCA tournament results —
      career podiums, head-to-head records, and season rankings for
      {players.length} players in the state ranking circuit.
    </p>
    <div>
      <a class="btn btn-primary" href={url('/players')}>Browse players</a>
      <a class="btn btn-ghost" href={url('/leaderboards')}>See leaderboards</a>
    </div>
  </section>

  {groups.map(g => (
    <>
      <h2 class="group-title">{g.label}</h2>
      <section class="stat-cards" aria-label={`${g.label} overview`}>
        <div class="stat-card stat-gold">
          <span class="stat-icon" aria-hidden="true">1st</span>
          <span class="stat-value">{g.totalFirsts}</span>
          <span class="stat-label">Tournament wins</span>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">◆</span>
          <span class="stat-value">{g.totalPodiums}</span>
          <span class="stat-label">Podium finishes</span>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">#</span>
          <span class="stat-value">{g.players.length}</span>
          <span class="stat-label">Players</span>
        </div>
      </section>
    </>
  ))}

  <section class="grid-2 page-section">
    {groups.map(g => (
      <div class="card">
        <div class="section-heading">
          <h2>Most wins · {g.label}</h2>
          <p class="section-desc">Ranked by 1st-place finishes, then by total top-8 appearances.</p>
        </div>
        {g.topByWins.length === 0 ? (
          <p class="empty">No player data yet. Run <code>npm run refresh</code>.</p>
        ) : (
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr><th></th><th>Player</th><th class="num">1st</th><th class="num">Top&nbsp;8</th></tr>
              </thead>
              <tbody>
                {g.topByWins.map((p, i) => (
                  <tr>
                    <td>
                      <span class:list={['rank-badge', i < 3 && `rank-${i + 1}`]}>{i + 1}</span>
                    </td>
                    <td>
                      <a href={url(`/players/${p.slug}`)}>{p.name}</a>
                      {p.city && <><br /><span class="muted small">{p.city}</span></>}
                    </td>
                    <td class="num">{p.podium.first}</td>
                    <td class="num muted-num">{p.podium.top8}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    ))}

    <div class="card">
      <div class="section-heading">
        <h2>Latest tournaments</h2>
        <p class="section-desc">Most recent events with scraped top-8 results.</p>
      </div>
      {latestTournaments.length === 0 ? (
        <p class="empty">No tournaments scraped yet.</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>Date</th><th>Tournament</th><th class="num">Categories</th></tr>
            </thead>
            <tbody>
              {latestTournaments.map(t => (
                <tr>
                  <td class="mono muted small">{t.date ?? '—'}</td>
                  <td>
                    <a href={url(`/tournaments/${t.slug}`)}>{t.title}</a>
                    <br /><span class="muted small">{t.season}</span>
                  </td>
                  <td class="num muted-num">{t.categories.length}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>
</Base>
